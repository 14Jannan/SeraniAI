# Copy to .env for local dev. In production, set these as environment
# variables in your hosting provider's dashboard (Render/Railway/etc.) -
# never commit real secrets to a file.

PORT=7001
NODE_ENV=development

# Public URL of the deployed frontend (Vercel) / this backend, respectively.
# Required in production - server.js refuses to boot without them.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:7001

# Internal Chroma vector service (see chroma_service/.env.example).
CHROMA_URL=http://localhost:8000
# Shared secret sent as X-Internal-Api-Key - must exactly match
# CHROMA_SERVICE_API_KEY in chroma_service/.env. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHROMA_SERVICE_API_KEY=
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# JWT secrets - generate separate long random strings for each, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Used to encrypt sensitive stored data (e.g. OAuth tokens at rest).
ENCRYPTION_KEY=

# MongoDB Atlas (or self-hosted) connection string. Required in production.
CONNECTION_STRING=

# SMTP-sending Gmail account used for OTP/notification emails. EMAIL_PASS is
# a Google App Password, not the account password. Required in production.
EMAIL_USER=
EMAIL_PASS=

# OAuth login providers - optional. Only the providers with both ID and
# secret set are enabled (see config/passport.js). Each provider's callback
# URL must be registered as:
#   {BACKEND_URL}/api/auth/google/callback
#   {BACKEND_URL}/api/auth/github/callback
#   {BACKEND_URL}/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Required in production - powers chat/journal AI features.
OPENAI_API_KEY=
MODEL=gpt-4o-mini

# PayHere payment gateway. Required in production.
PAYHERE_ENV=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MOBILE_MERCHANT_SECRET=
PAYHERE_SECRET_FORMAT=plain
PAYHERE_APP_SECRET_FORMAT=plain
PAYHERE_SIGNING_SECRET_SOURCE=merchant
PAYHERE_HASH_MODE=auto

PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Must point at the deployed FRONTEND_URL / BACKEND_URL, not localhost, once
# this is actually hosted.
PAYHERE_RETURN_URL=http://localhost:5173/subscription?payment=success
PAYHERE_CANCEL_URL=http://localhost:5173/subscription?payment=cancelled
PAYHERE_NOTIFY_URL=http://localhost:7001/api/billing/payhere/notify

# Optional - if unset, caching is transparently disabled (utils/redisClient.js).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
