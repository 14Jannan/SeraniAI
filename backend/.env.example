# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=7001
NODE_ENV=development

# Public URLs of the frontend and this backend.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:7001

CHROMA_API_URL=http://localhost:5000/api
# Shared secret sent as the X-Internal-Api-Key header to chroma_service.
# Must match CHROMA_SERVICE_API_KEY in chroma_service/.env.
CHROMA_SERVICE_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# openssl rand -hex 32 - 32-byte hex key for AES-256-GCM chat encryption.
ENCRYPTION_KEY=

# Include the database name in the connection string.
CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=Cluster0

EMAIL_USER=
EMAIL_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

OPENAI_API_KEY=
MODEL=gpt-4o-mini

JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# PayHere
PAYHERE_ENV=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MOBILE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MOBILE_MERCHANT_SECRET=
PAYHERE_HASH_MODE=auto
PAYHERE_SECRET_FORMAT=auto
PAYHERE_APP_SECRET_FORMAT=plain
PAYHERE_SIGNING_SECRET_SOURCE=merchant

PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# PayHere requires publicly reachable HTTPS URLs in production.
PAYHERE_RETURN_URL=http://localhost:5173/subscription?payment=success
PAYHERE_CANCEL_URL=http://localhost:5173/subscription?payment=cancelled
PAYHERE_NOTIFY_URL=http://localhost:7001/api/billing/payhere/notify

# Redis (optional - caching is disabled automatically if unset/unreachable)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Or, for a hosted Redis instance:
# REDIS_URL=rediss://default:password@host:port
