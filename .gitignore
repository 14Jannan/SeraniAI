# Dependencies
node_modules/
backend/node_modules/
mobile/node_modules/
web/node_modules/

# Environment files
.env
.env.*
backend/.env
mobile/.env
web/.env

# Expo / React Native
mobile/.expo/
mobile/.expo-shared/

# Build outputs
dist/
build/
coverage/
web/dist/
web/dist-ssr/
web/.vite/

# User-uploaded content (served from backend/uploads at runtime; should
# never be committed - these are real user files, not source code)
backend/uploads/*
!backend/uploads/.gitkeep

# Python (chroma_service)
chroma_service/venv/
chroma_service/__pycache__/
**/__pycache__/
*.pyc
chroma_service/chroma_db/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

