# Dependencies
node_modules/
backend/node_modules/
mobile/node_modules/
web/node_modules/

# Environment files
.env
.env.*
backend/.env
mobile/.env
web/.env
chroma_service/.env
# ...but keep the committed templates that document required vars.
!.env.example
!**/.env.example

# Expo / React Native
mobile/.expo/
mobile/.expo-shared/

# Build outputs
dist/
build/
coverage/
web/dist/
web/dist-ssr/
web/.vite/

# User-uploaded files (course thumbnails/videos, chat attachments) - never
# belong in source control.
backend/uploads/*
!backend/uploads/.gitkeep

# Ad-hoc debug scripts and generated output that shouldn't be committed.
backend/scratch/
backend/testRedis.js
backend/extracted_text.txt
backend/rasterization_text.txt
backend/test-results.txt

# Chroma's local persistent vector store.
chroma_service/chroma_db/
chroma_service/__pycache__/
chroma_service/.venv/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

