# Copy to .env for local dev. For deployment (Vercel), set these as
# Environment Variables in the project's dashboard instead - Vite inlines
# them at build time, so they must be set before each deploy build.

# Base URL of the deployed backend API (no trailing slash, no /api suffix -
# each api/*.js module appends its own path). Falls back to
# http://localhost:7001 if unset (see src/utils/apiBaseUrl.js).
VITE_API_BASE_URL=http://localhost:7001

# Cloudinary unsigned upload target used for course/lesson media uploads.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
