# Copy to .env.local (dev) or configure as build-time env vars on your
# hosting provider for production. All Vite env vars used by the app must
# be prefixed with VITE_ to be exposed to client code.

# Base URL of the backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:7001

# Optional: only needed if the admin course/lesson image upload flow uses
# direct-to-Cloudinary unsigned uploads.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
