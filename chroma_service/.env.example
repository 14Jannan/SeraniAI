# Copy to .env and fill in real values for anything beyond local dev.

CHROMA_PORT=5000
CHROMA_HOST=0.0.0.0

# Shared secret the Node backend sends as X-Internal-Api-Key. Must match
# CHROMA_SERVICE_API_KEY in backend/.env. Required outside local dev.
CHROMA_SERVICE_API_KEY=

# Origin allowed to call this service via browser CORS (the backend's URL).
CHROMA_ALLOWED_ORIGIN=http://localhost:7001
