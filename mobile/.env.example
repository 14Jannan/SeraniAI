# Copy to .env.
#
# Leave EXPO_PUBLIC_API_URL commented out for local development - the app
# auto-detects the right backend host (Metro dev server / 10.0.2.2 /
# localhost) when it's unset. Only uncomment and set this for a release
# build, pointed at a real, reachable backend URL - setting it locally
# overrides that auto-detection unconditionally and breaks every API call,
# including login, against your local dev backend.
# EXPO_PUBLIC_API_URL=https://api.seraniai.com/api

# NOTE: PayHere merchant/app credentials must NEVER live here. EXPO_PUBLIC_*
# values are compiled into the client bundle and readable by anyone who
# downloads the app. Those secrets belong only in the backend's .env.
