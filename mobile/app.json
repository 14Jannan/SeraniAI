{
  "expo": {
    "name": "SeraniAI",
    "slug": "seraniaiapp",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "seraniaiapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seraniaiapp.mobile"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.seraniaiapp.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "seraniaiapp" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID.",
          "isUserDefinedKeychainSynchronizationEnabled": false
        }
      ],
      "expo-web-browser"
    ]
  }
}