{
  "expo": {
    "name": "SeraniAI",
    "slug": "seraniaiapp",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "seraniaiapp",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seraniaiapp.mobile",
      "buildNumber": "1"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.seraniaiapp.mobile",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "seraniaiapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to access your Face ID.",
          "isUserDefinedKeychainSynchronizationEnabled": false
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-dev-client",
      "./plugins/withPayHere"
    ],
    "extra": {
      "eas": {
        "projectId": "382d3395-054b-4fa6-b488-d831f9c39136"
      }
    }
  }
}
